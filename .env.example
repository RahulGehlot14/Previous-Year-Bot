# OpenAI API Key for AI-driven question classification
OPENAI_API_KEY=your_openai_api_key_here

# Default Model Selection: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Optional override, defaults to pyq_analyzer.db)
DATABASE_PATH=database/pyq_analyzer.db

# App Environment: development / production
APP_ENV=development
